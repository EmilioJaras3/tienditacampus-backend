NODE_ENV=development
TZ=America/Mexico_City
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tienditacampus
POSTGRES_USER=tc_admin
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_DB_PASSWORD
BACKEND_PORT=3001
PORT=3001
JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET
JWT_EXPIRATION=7d
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
DEFAULT_ADMIN_EMAIL=admin@tienditacampus.com
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
FRONTEND_URL=http://localhost:3000

# -- BigQuery / Google OAuth --
GCP_PROJECT_ID=REPLACE_WITH_GCP_PROJECT_ID
BIGQUERY_DATASET=benchmarking_warehouse
BIGQUERY_TABLE=daily_query_metrics
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# -- SMTP / 2FA --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_YOUR_EMAIL
SMTP_PASS=REPLACE_WITH_YOUR_APP_PASSWORD
SMTP_FROM=TienditaCampus <noreply@tienditacampus.com>
