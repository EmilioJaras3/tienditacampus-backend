# ============================================================
# TienditaCampus - Entorno de DESARROLLO (Dev)
# ============================================================
# Este archivo se usa cuando NODE_ENV=development
# Valores relajados para desarrollo local
# ============================================================

NODE_ENV=development
TZ=America/Mexico_City

# ── Base de Datos ──────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tienditacampus_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
POSTGRES_SSL=false
POSTGRES_SYNCHRONIZE=false

# ── Backend ────────────────────────────────────────────────
BACKEND_PORT=3001
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=dev-secret-only
JWT_EXPIRATION=7d

# ── Argon2 (valores reducidos para velocidad en dev) ──────
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ── Admin Seed ─────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@tienditacampus.com
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# ── BigQuery / Google OAuth ────────────────────────────────
GCP_PROJECT_ID=REPLACE_WITH_GCP_PROJECT_ID
BIGQUERY_DATASET=benchmarking_warehouse
BIGQUERY_TABLE=daily_query_metrics
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ── Roles y Permisos (Configuración por Entorno) ──────────
DB_SCHEMA=public
DB_APP_ROLE=tc_app_dev
DB_READONLY_ROLE=tc_readonly_dev
